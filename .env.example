# Runtime credentials and workspace for `file-system-mcp tunnel`.
CONTROL_PLANE_API_KEY="replace-with-your-runtime-api-key"
TUNNEL_ID="tunnel_your_id"
WORKSPACE_ROOT="$HOME/Projects/workspace"

# Local observer dashboard; override with `tunnel --dashboard-port <PORT>`.
MCP_DASHBOARD_PORT="9411"

# SQLite volume, outside WORKSPACE_ROOT. Relative paths use this .env directory.
MCP_OBSERVER_DB=".data/observer.sqlite3"
